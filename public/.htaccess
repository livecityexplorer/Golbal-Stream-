# ==============================================================================
# NAMECHEAP STELLAR PLUS HOSTING - PRODUCTION APACHE CONFIGURATION
# Optimized for Ultra-Fast Loading, Core Web Vitals, Gzip, SSL & SPA Routing
# ==============================================================================

# 1. PREVENT DIRECTORY LISTING & SET DIRECTORY INDEX
Options -Indexes
DirectoryIndex index.html index.php

# 2. FORCE UTF-8 ENCODING
AddDefaultCharset UTF-8
AddType 'text/html; charset=UTF-8' html

# 3. MIME TYPES FOR MODERN WEB FORMATS
<IfModule mod_mime.c>
  AddType application/xml xml
  AddType text/xml xml
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  AddType image/avif avif
  AddType font/woff2 woff2
  AddType font/woff woff
  AddType application/json json
  AddType application/manifest+json webmanifest
</IfModule>

# 4. GZIP / DEFLATE COMPRESSION (Google Core Web Vitals Optimization)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. BROWSWER CACHING & EXPIRES HEADERS
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - Never cache aggressively to ensure updates are seen immediately
  ExpiresByType text/html "access plus 0 seconds"

  # CSS and JavaScript (Vite outputs content-hashed filenames)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Media: Images, Icons, Video
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # WebFonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# 6. CACHE-CONTROL HEADERS
<IfModule mod_headers.c>
  # 1-Year Immutable cache for hashed assets
  <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|webp|avif|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML files - Revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Explicit Content-Type for XML sitemaps & Robots
  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Cache-Control "max-age=3600, public"
    Header set Access-Control-Allow-Origin "*"
  </Files>

  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "max-age=3600, public"
    Header set Access-Control-Allow-Origin "*"
  </Files>

  # AI LLM Knowledge Base Discovery & Open Access
  <FilesMatch "^llms(-full)?\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "max-age=3600, public"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Link header on HTML documents to point AI scrapers directly to the LLM Knowledge Base
  <FilesMatch "\.(html|htm)$">
    Header add Link "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\""
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. REWRITE ENGINE: FORCE HTTPS & SPA ROUTING FALLBACK
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Exclude ACME / SSL Domain Validation directories from redirection
  RewriteRule ^\.well-known/ - [L]

  # Force HTTPS on Namecheap (AutoSSL compatible)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical Domain: 301 Redirect www to non-www dynamically for any active domain
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # 301 Permanent Redirects for Language Query Strings to Clean Canonical URLs
  # Resolves Google Search Console "Alternative page with proper canonical tag" validation
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$) [NC]
  RewriteRule ^$ /france-iptv [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (^|&)lang=de(&|$) [NC]
  RewriteRule ^$ /germany-iptv [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (^|&)lang=es(&|$) [NC]
  RewriteRule ^$ /spain-iptv [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (^|&)lang=it(&|$) [NC]
  RewriteRule ^$ /italy-iptv [R=301,L,QSD]

  # Redirect unsupported/invalid query params directly to clean root canonical
  RewriteCond %{QUERY_STRING} (^|&)lang= [NC]
  RewriteRule ^$ / [R=301,L,QSD]

  # Route /api/checkout/nowpayments to the secure PHP backend
  RewriteRule ^api/checkout/nowpayments/?$ api/checkout/nowpayments.php [L]

  # Explicitly allow static SEO & discovery assets to be served directly without rewrite
  RewriteRule ^(sitemap\.xml|robots\.txt|llms\.txt|llms-full\.txt)$ - [L]

  # Don't rewrite files or directories that exist physically
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other requests to index.html for Single Page Application routing
  RewriteRule ^ index.html [L]
</IfModule>
